<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 1. ACADEMIC YEAR -->
        <record id="view_academic_year_tree" model="ir.ui.view">
            <field name="name">academic.year.list</field>
            <field name="model">academic.year</field>
            <field name="arch" type="xml">
                <list string="Tahun Akademik">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="semester_type" widget="badge"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="is_active" widget="boolean_toggle"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_academic_year_form" model="ir.ui.view">
            <field name="name">academic.year.form</field>
            <field name="model">academic.year</field>
            <field name="arch" type="xml">
                <form string="Tahun Akademik">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Tahun Akademik"/>
                            <h1><field name="name" placeholder="misal: 2026/2027 Ganjil"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" placeholder="20261"/>
                                <field name="semester_type"/>
                                <field name="is_active"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- 2. ACADEMIC FACULTY -->
        <record id="view_academic_faculty_tree" model="ir.ui.view">
            <field name="name">academic.faculty.list</field>
            <field name="model">academic.faculty</field>
            <field name="arch" type="xml">
                <list string="Fakultas">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="dekan_id"/>
                </list>
            </field>
        </record>

        <record id="view_academic_faculty_form" model="ir.ui.view">
            <field name="name">academic.faculty.form</field>
            <field name="model">academic.faculty</field>
            <field name="arch" type="xml">
                <form string="Fakultas">
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="dekan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <notebook>
                            <page string="Program Studi">
                                <field name="program_ids">
                                    <list>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="degree"/>
                                        <field name="kaprodi_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- 3. ACADEMIC PROGRAM -->
        <record id="view_academic_program_tree" model="ir.ui.view">
            <field name="name">academic.program.list</field>
            <field name="model">academic.program</field>
            <field name="arch" type="xml">
                <list string="Program Studi">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="degree" widget="badge"/>
                    <field name="faculty_id"/>
                    <field name="kaprodi_id"/>
                    <field name="total_sks_graduation"/>
                </list>
            </field>
        </record>

        <record id="view_academic_program_form" model="ir.ui.view">
            <field name="name">academic.program.form</field>
            <field name="model">academic.program</field>
            <field name="arch" type="xml">
                <form string="Program Studi">
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="degree"/>
                                <field name="faculty_id"/>
                            </group>
                            <group>
                                <field name="kaprodi_id"/>
                                <field name="total_sks_graduation"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- 4. ACADEMIC COURSE -->
        <record id="view_academic_course_tree" model="ir.ui.view">
            <field name="name">academic.course.list</field>
            <field name="model">academic.course</field>
            <field name="arch" type="xml">
                <list string="Mata Kuliah">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="sks"/>
                    <field name="credits"/>
                    <field name="semester_recommended"/>
                    <field name="program_id"/>
                    <field name="lecturer_id"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_academic_course_form" model="ir.ui.view">
            <field name="name">academic.course.form</field>
            <field name="model">academic.course</field>
            <field name="arch" type="xml">
                <form string="Mata Kuliah">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="active,inactive"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="sks"/>
                                <field name="credits"/>
                            </group>
                            <group>
                                <field name="semester_recommended"/>
                                <field name="program_id"/>
                                <field name="faculty_id"/>
                                <field name="lecturer_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
