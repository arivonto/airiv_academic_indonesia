<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_academic_krs_tree" model="ir.ui.view">
            <field name="name">academic.krs.list</field>
            <field name="model">academic.krs</field>
            <field name="arch" type="xml">
                <list string="Kartu Rencana Studi">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="nim"/>
                    <field name="program_id"/>
                    <field name="academic_year_id"/>
                    <field name="total_sks"/>
                    <field name="gpa_semester"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_academic_krs_form" model="ir.ui.view">
            <field name="name">academic.krs.form</field>
            <field name="model">academic.krs</field>
            <field name="arch" type="xml">
                <form string="Kartu Rencana Studi">
                    <header>
                        <button name="action_submit" string="Ajukan KRS" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_approve" string="Setujui (Dosen PA)" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                        <button name="action_lock_grades" string="Kunci Nilai Semester" type="object" class="btn-secondary" invisible="state != 'approved'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,graded"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nomor KRS"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Mahasiswa">
                                <field name="student_id"/>
                                <field name="nim"/>
                                <field name="program_id"/>
                            </group>
                            <group string="Periode &amp; Hasil">
                                <field name="academic_year_id"/>
                                <field name="total_sks"/>
                                <field name="gpa_semester"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Daftar Mata Kuliah &amp; Nilai">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="course_id"/>
                                        <field name="sks"/>
                                        <field name="credits" column_invisible="True"/>
                                        <field name="lecturer_id"/>
                                        <field name="score_attendance"/>
                                        <field name="score_assignment"/>
                                        <field name="score_uts"/>
                                        <field name="score_uas"/>
                                        <field name="score_final"/>
                                        <field name="grade_letter" widget="badge"/>
                                        <field name="grade_point"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_academic_krs" model="ir.actions.act_window">
            <field name="name">Rencana Studi &amp; KHS</field>
            <field name="res_model">academic.krs</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
