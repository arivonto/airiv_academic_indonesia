<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_academic_student_tree" model="ir.ui.view">
            <field name="name">academic.student.list</field>
            <field name="model">academic.student</field>
            <field name="arch" type="xml">
                <list string="Daftar Mahasiswa / Siswa">
                    <field name="nim"/>
                    <field name="name"/>
                    <field name="program_id"/>
                    <field name="academic_year_id"/>
                    <field name="current_semester"/>
                    <field name="gpa_cumulative" widget="badge"/>
                    <field name="total_sks_earned"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_academic_student_form" model="ir.ui.view">
            <field name="name">academic.student.form</field>
            <field name="model">academic.student</field>
            <field name="arch" type="xml">
                <form string="Data Mahasiswa">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="active,leave,graduated"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nama Lengkap"/>
                            <h1><field name="name" placeholder="Nama Mahasiswa / Siswa"/></h1>
                        </div>
                        <group>
                            <group string="Identitas &amp; Akademik">
                                <field name="nim" placeholder="Nomor Induk Mahasiswa"/>
                                <field name="nik" placeholder="16 Digit NIK"/>
                                <field name="gender"/>
                                <field name="program_id"/>
                                <field name="faculty_id"/>
                                <field name="academic_year_id"/>
                                <field name="academic_advisor_id"/>
                            </group>
                            <group string="Kontak &amp; Prestasi">
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="current_semester"/>
                                <field name="gpa_cumulative"/>
                                <field name="total_sks_earned"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Riwayat Kartu Rencana Studi (KRS)">
                                <field name="krs_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="academic_year_id"/>
                                        <field name="semester_type"/>
                                        <field name="total_sks"/>
                                        <field name="gpa_semester"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_academic_student_search" model="ir.ui.view">
            <field name="name">academic.student.search</field>
            <field name="model">academic.student</field>
            <field name="arch" type="xml">
                <search string="Cari Mahasiswa">
                    <field name="name"/>
                    <field name="nim"/>
                    <field name="program_id"/>
                    <filter string="Aktif" name="filter_active" domain="[('state', '=', 'active')]"/>
                    <filter string="Lulus" name="filter_graduated" domain="[('state', '=', 'graduated')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Program Studi" name="group_program" domain="[]" context="{'group_by': 'program_id'}"/>
                        <filter string="Angkatan" name="group_year" domain="[]" context="{'group_by': 'academic_year_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_academic_student" model="ir.actions.act_window">
            <field name="name">Mahasiswa &amp; Siswa</field>
            <field name="res_model">academic.student</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_academic_student_search"/>
        </record>
    </data>
</odoo>
