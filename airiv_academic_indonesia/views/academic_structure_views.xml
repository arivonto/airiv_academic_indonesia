<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_academic_year_tree" model="ir.ui.view">
            <field name="name">academic.year.list</field>
            <field name="model">academic.year</field>
            <field name="arch" type="xml">
                <list string="Tahun Akademik / Semester">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="semester_type" widget="badge"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="is_active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_academic_program_tree" model="ir.ui.view">
            <field name="name">academic.program.list</field>
            <field name="model">academic.program</field>
            <field name="arch" type="xml">
                <list string="Program Studi / Jurusan">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="tier" widget="badge"/>
                    <field name="faculty_id"/>
                </list>
            </field>
        </record>

        <record id="view_academic_course_tree" model="ir.ui.view">
            <field name="name">academic.course.list</field>
            <field name="model">academic.course</field>
            <field name="arch" type="xml">
                <list string="Mata Pelajaran / Kuliah">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="program_id"/>
                    <field name="credits"/>
                    <field name="semester_recommended"/>
                </list>
            </field>
        </record>

        <record id="action_academic_year" model="ir.actions.act_window">
            <field name="name">Tahun Akademik</field>
            <field name="res_model">academic.year</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_academic_program" model="ir.actions.act_window">
            <field name="name">Program Studi / Jurusan</field>
            <field name="res_model">academic.program</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_academic_course" model="ir.actions.act_window">
            <field name="name">Mata Kuliah / Pelajaran</field>
            <field name="res_model">academic.course</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
